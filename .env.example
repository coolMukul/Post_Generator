# Database Configuration
DATABASE_URL=postgresql://postgenerator:your_password@localhost:5432/post_generator
DB_HOST=localhost
DB_PORT=5432
DB_NAME=post_generator
DB_USER=postgenerator
DB_PASSWORD=your_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_PORT=3201
API_HOST=0.0.0.0
NODE_ENV=development

# Embedding Provider: "openai" or "gemini"
EMBEDDING_PROVIDER=gemini
# Override model/dimension if needed (defaults per provider)
# EMBEDDING_MODEL=models/text-embedding-004
# EMBEDDING_DIMENSION=768

# LLM Provider for agents (Phase 4 & 5): "gemini" or "openai"
# Uses the same API key as the embedding provider (GEMINI_API_KEY or OPENAI_API_KEY)
# Default model: gemini-2.0-flash (free tier) or gpt-4o-mini
LLM_PROVIDER=gemini
# Override model if needed:
# LLM_MODEL=gemini-2.0-flash

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# LlamaParse Configuration (for PDF parsing)
LLAMA_CLOUD_API_KEY=your_llamaparse_api_key_here

# Worker Configuration
WORKER_CONCURRENCY=5
