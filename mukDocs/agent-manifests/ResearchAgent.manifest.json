{
  "name": "ResearchAgent",
  "version": "1.0.0",
  "description": "Uses Phase 3 hybrid_retrieve to search ingested documents. Returns ranked results, findings, and recommended next steps.",
  "tools": ["search_papers", "summarize_chunk"],
  "input_schema": {
    "type": "object",
    "properties": {
      "query": { "type": "string", "minLength": 1 },
      "search_mode": { "type": "string", "enum": ["hybrid", "vector", "keyword"], "default": "hybrid" },
      "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
      "min_score": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0 },
      "document_id": { "type": "string", "nullable": true }
    },
    "required": ["query"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "job_id": { "type": "string" },
      "top_documents": { "type": "array", "items": { "type": "object" } },
      "findings": { "type": "array", "items": { "type": "string" } },
      "risks_and_unknowns": { "type": "array", "items": { "type": "string" } },
      "recommended_next_steps": { "type": "array", "items": { "type": "string" } },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "required": ["job_id", "top_documents", "findings", "risks_and_unknowns", "recommended_next_steps", "confidence"]
  },
  "time_budget": {
    "default_seconds": 120,
    "max_seconds": 300
  },
  "queue_job_type": "agent_run",
  "reuses": ["hybrid_retrieve via POST /search/submit"]
}
