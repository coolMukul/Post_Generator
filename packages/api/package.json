{
  "name": "@post-generator/api",
  "version": "1.0.0",
  "description": "Fastify API server for research insight generation",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "python -m uvicorn app.main:app --host 0.0.0.0 --port 3201 --reload",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/env": "^4.3.0",
    "fastify": "^4.26.1",
    "bullmq": "^5.4.0",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "zod": "^3.22.4",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
